<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="004-items-inventory" author="dungeontasks">
        <createTable tableName="item_definition">
            <column name="item_id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_item_definition"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="rarity" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="attack_bonus" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="defense_bonus" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="luck_bonus" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="user_item">
            <column name="user_item_id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_item"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="item_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="is_equipped" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="obtained_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="user_item" baseColumnNames="user_id"
                                 referencedTableName="app_user" referencedColumnNames="user_id"
                                 constraintName="fk_user_item_user" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="user_item" baseColumnNames="item_id"
                                 referencedTableName="item_definition" referencedColumnNames="item_id"
                                 constraintName="fk_user_item_definition" onDelete="RESTRICT"/>
        <createIndex tableName="user_item" indexName="ix_user_item_user">
            <column name="user_id"/>
        </createIndex>

        <insert tableName="item_definition">
            <column name="item_id" value="11111111-1111-1111-1111-111111111101"/>
            <column name="name" value="Rusty Dagger"/>
            <column name="description" value="An old dagger found in training grounds."/>
            <column name="rarity" value="COMMON"/>
            <column name="type" value="WEAPON"/>
            <column name="attack_bonus" valueNumeric="2"/>
        </insert>
        <insert tableName="item_definition">
            <column name="item_id" value="11111111-1111-1111-1111-111111111102"/>
            <column name="name" value="Steel Sword"/>
            <column name="description" value="Well-balanced sword forged by city blacksmith."/>
            <column name="rarity" value="RARE"/>
            <column name="type" value="WEAPON"/>
            <column name="attack_bonus" valueNumeric="12"/>
        </insert>
        <insert tableName="item_definition">
            <column name="item_id" value="11111111-1111-1111-1111-111111111103"/>
            <column name="name" value="Knight Armor"/>
            <column name="description" value="Heavy chestplate providing reliable protection."/>
            <column name="rarity" value="RARE"/>
            <column name="type" value="ARMOR"/>
            <column name="defense_bonus" valueNumeric="10"/>
        </insert>
        <insert tableName="item_definition">
            <column name="item_id" value="11111111-1111-1111-1111-111111111104"/>
            <column name="name" value="Ring of Focus"/>
            <column name="description" value="A magic ring that sharpens the mind."/>
            <column name="rarity" value="UNCOMMON"/>
            <column name="type" value="RING"/>
            <column name="luck_bonus" valueNumeric="5"/>
        </insert>
        <insert tableName="item_definition">
            <column name="item_id" value="11111111-1111-1111-1111-111111111105"/>
            <column name="name" value="Dragonbane Blade"/>
            <column name="description" value="Legendary weapon glowing with dragon fire."/>
            <column name="rarity" value="LEGENDARY"/>
            <column name="type" value="WEAPON"/>
            <column name="attack_bonus" valueNumeric="35"/>
            <column name="luck_bonus" valueNumeric="10"/>
        </insert>
    </changeSet>

    <changeSet id="004-items-inventory-alter" author="dungeontasks">
        <addColumn tableName="quest_completion">
            <column name="loot_user_item_id" type="uuid"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>