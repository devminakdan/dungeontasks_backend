# Local development only. Copy to .env before running Docker Compose.
POSTGRES_DB=dungeontasks
POSTGRES_USER=dungeontasks
POSTGRES_PASSWORD=dungeontasks-local-only
POSTGRES_PORT=5432
BACKEND_PORT=8080
JWT_SECRET=replace-with-a-random-local-secret-at-least-32-bytes
JWT_ISSUER=dungeontasks-backend
JWT_AUDIENCE=dungeontasks-ios
# Add the Web OAuth Client ID from Google Cloud when it is available.
GOOGLE_WEB_CLIENT_ID=
